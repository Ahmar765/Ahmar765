name: Update profile art

on:
  schedule:
    - cron: '17 6 * * *'
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - profile.json
      - scripts/**
      - assets/**
      - .github/workflows/update-profile-art.yml

permissions:
  contents: write

concurrency:
  group: profile-art-${{ github.ref }}
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r scripts/requirements.txt
      - name: Fetch avatar if no portrait has been supplied
        shell: bash
        run: |
          if [ ! -f assets/avatar.png ]; then
            python scripts/build_profile.py --avatar
          fi
      - name: Fetch and render real contributions
        run: python scripts/build_profile.py --fetch
      - name: Commit updated artwork
        shell: bash
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add -- avi-ascii.svg info-card.svg contrib-heatmap.svg data/contributions.json assets/
          if ! git diff --cached --quiet; then
            git commit -m 'chore: refresh profile artwork [skip ci]'
            git push
          fi
